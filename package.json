{
  "name": "kitty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@12.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.15.0",
    "npm": "12.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@kitty/app",
    "build": "npm run build --workspace=@kitty/app",
    "render:demo": "npm run build && node scripts/render-demo.mjs",
    "preview": "npm run preview --workspace=@kitty/app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=@kitty/app",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@kinky-vibes/ui": "0.1.0",
    "klangwerk": "github:TheAnonymous/Klangwerk#bfd31d4a203bf9aca240eb1a1260bdad6620edd2",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.13.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
